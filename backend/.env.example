# Puerto donde corre la API (y la app compilada)
PORT=3000
# Clave para firmar los tokens JWT. ¡Cámbiala en producción!
JWT_SECRET=cambia-esta-clave-secreta
JWT_EXPIRES_IN=8h
# Ruta del archivo de base de datos SQLite
DB_PATH=data/techstock.db
# Origen permitido para CORS en desarrollo (frontend de Vite)
CORS_ORIGIN=http://localhost:5173
